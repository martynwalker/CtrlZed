<Window x:Class="CtrlZed.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CtrlZed — beta 5" Width="1100" Height="760" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
<DockPanel>
<Menu DockPanel.Dock="Top">
<MenuItem Header="_File"><MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click"/><MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="Open_Click"/><MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click"/><Separator/><MenuItem Header="Page Set_up…" Click="PageSetup_Click"/><MenuItem Header="_Print…" InputGestureText="Ctrl+P" Click="Print_Click"/><Separator/><MenuItem Header="E_xit" Click="Exit_Click"/></MenuItem>
<MenuItem Header="_Edit"><MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}"/><Separator/><MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Copy" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}"/></MenuItem>
<MenuItem Header="_Insert"><MenuItem Header="_Picture…" Click="Picture_Click"/><Separator/><MenuItem Header="_Header and Footer…" Click="HeaderFooter_Click"/></MenuItem>
<MenuItem Header="F_ormat"><MenuItem Header="_Bold" InputGestureText="Ctrl+B" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Italic" InputGestureText="Ctrl+I" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Underline" InputGestureText="Ctrl+U" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}"/><Separator/><MenuItem Header="_Normal" Tag="Normal" Click="StyleMenu_Click"/><MenuItem Header="Heading _1" Tag="Heading 1" Click="StyleMenu_Click"/><MenuItem Header="Heading _2" Tag="Heading 2" Click="StyleMenu_Click"/><MenuItem Header="Heading _3" Tag="Heading 3" Click="StyleMenu_Click"/><MenuItem Header="_Quote" Tag="Quote" Click="StyleMenu_Click"/><MenuItem Header="_Caption" Tag="Caption" Click="StyleMenu_Click"/></MenuItem>
<MenuItem Header="_View"><MenuItem Header="_Page Preview…" Click="PagePreview_Click"/></MenuItem>
<MenuItem Header="_Keyboard"><MenuItem x:Name="WordProfile" Header="Microsoft _Word" IsCheckable="True" IsChecked="True" Click="Keyboard_Click"/><MenuItem x:Name="WPProfile" Header="Word_Perfect 5.1" IsCheckable="True" Click="Keyboard_Click"/><MenuItem x:Name="WSProfile" Header="Word_Star 4.0" IsCheckable="True" Click="Keyboard_Click"/></MenuItem>
<MenuItem Header="_Tools"><MenuItem Header="_Fields…" Click="Fields_Click"/><MenuItem Header="_Macro Library…" Click="MacroLibrary_Click"/></MenuItem>
<MenuItem Header="_Help"><MenuItem Header="_About CtrlZed" Click="About_Click"/></MenuItem>
</Menu>
<ToolBarTray DockPanel.Dock="Top"><ToolBar>
<Button Content="B" FontWeight="Bold" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}"/>
<Button Content="I" FontStyle="Italic" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}"/>
<Button Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}"><TextBlock Text="U" TextDecorations="Underline"/></Button>
<Separator/><ComboBox x:Name="StyleBox" Width="125" SelectionChanged="StyleBox_SelectionChanged"><ComboBoxItem IsSelected="True">Normal</ComboBoxItem><ComboBoxItem>Heading 1</ComboBoxItem><ComboBoxItem>Heading 2</ComboBoxItem><ComboBoxItem>Heading 3</ComboBoxItem><ComboBoxItem>Quote</ComboBoxItem><ComboBoxItem>Caption</ComboBoxItem></ComboBox>
<ComboBox x:Name="FontBox" Width="190" SelectionChanged="FontBox_SelectionChanged"/><ComboBox x:Name="SizeBox" Width="70" IsEditable="True" SelectionChanged="SizeBox_SelectionChanged"><ComboBoxItem>9</ComboBoxItem><ComboBoxItem>10</ComboBoxItem><ComboBoxItem>11</ComboBoxItem><ComboBoxItem IsSelected="True">12</ComboBoxItem><ComboBoxItem>14</ComboBoxItem><ComboBoxItem>18</ComboBoxItem><ComboBoxItem>24</ComboBoxItem></ComboBox>
</ToolBar></ToolBarTray>
<StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="Status" Text="Ready — CtrlZed beta 5"/></StatusBar>
<ScrollViewer VerticalScrollBarVisibility="Auto" Background="#D7D7D7">
<Border x:Name="PageBorder" Width="794" MinHeight="1123" Margin="30" Padding="72" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock x:Name="HeaderPreview" Grid.Row="0" TextAlignment="Center" Foreground="#666" Margin="0,0,0,12" TextWrapping="Wrap"/>
<RichTextBox Grid.Row="1" x:Name="Editor" BorderThickness="0" AcceptsTab="True" SpellCheck.IsEnabled="True" FontFamily="Calibri" FontSize="16" VerticalScrollBarVisibility="Disabled" TextChanged="Editor_TextChanged"/>
<TextBlock x:Name="FooterPreview" Grid.Row="2" TextAlignment="Center" Foreground="#666" Margin="0,12,0,0" TextWrapping="Wrap"/>
</Grid>
</Border>
</ScrollViewer>
</DockPanel></Window>
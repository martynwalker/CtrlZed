<Window x:Class="CtrlZed.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CtrlZed" Title="CtrlZed — beta 17" Width="1100" Height="760" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
<DockPanel>
<Menu x:Name="MainMenu" DockPanel.Dock="Top">
<MenuItem Header="_File"><MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click"/><MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="Open_Click"/><MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/><MenuItem Header="_Recent Files" x:Name="RecentFilesMenu"/><Separator/><MenuItem Header="Document _Properties…" Click="DocumentProperties_Click"/><MenuItem Header="Page Set_up…" Click="PageSetup_Click"/><MenuItem Header="_Print…" InputGestureText="Ctrl+P" Click="Print_Click"/><Separator/><MenuItem Header="E_xit" Click="Exit_Click"/></MenuItem>
<MenuItem Header="_Edit"><MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}"/><Separator/><MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Copy" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}"/><Separator/><MenuItem Header="_Find / Replace…" InputGestureText="Ctrl+H" Click="FindReplace_Click"/></MenuItem>
<MenuItem Header="_Insert"><MenuItem Header="_Picture…" Click="Picture_Click"/><MenuItem Header="_Table…" Click="Table_Click"/><MenuItem Header="Page _Break" InputGestureText="Ctrl+Enter" Click="PageBreak_Click"/><Separator/><MenuItem Header="_Header and Footer…" Click="HeaderFooter_Click"/></MenuItem>
<MenuItem Header="F_ormat"><MenuItem Header="_Bold" InputGestureText="Ctrl+B" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Italic" InputGestureText="Ctrl+I" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Underline" InputGestureText="Ctrl+U" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}"/><Separator/><MenuItem Header="Align _Left" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="Align _Centre" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="Align _Right" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Justify" Command="EditingCommands.AlignJustify" CommandTarget="{Binding ElementName=Editor}"/><Separator/><MenuItem Header="_Bullets" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Numbering" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}"/><Separator/><MenuItem Header="_Normal" Tag="Normal" Click="StyleMenu_Click"/><MenuItem Header="Heading _1" Tag="Heading 1" Click="StyleMenu_Click"/><MenuItem Header="Heading _2" Tag="Heading 2" Click="StyleMenu_Click"/><MenuItem Header="Heading _3" Tag="Heading 3" Click="StyleMenu_Click"/><MenuItem Header="_Quote" Tag="Quote" Click="StyleMenu_Click"/><MenuItem Header="_Caption" Tag="Caption" Click="StyleMenu_Click"/></MenuItem>
<MenuItem Header="_Table"><MenuItem Header="Add Row _Below" Click="TableAddRow_Click"/><MenuItem Header="Add Column _Right" Click="TableAddColumn_Click"/><Separator/><MenuItem Header="Delete _Row" Click="TableDeleteRow_Click"/><MenuItem Header="Delete _Column" Click="TableDeleteColumn_Click"/></MenuItem>
<MenuItem Header="_View"><MenuItem Header="_Navigation Pane" IsCheckable="True" Click="NavigationPane_Click"/><MenuItem Header="_Page Preview…" Click="PagePreview_Click"/><Separator/><MenuItem Header="Zoom _50%" Tag="50" Click="Zoom_Click"/><MenuItem Header="Zoom _75%" Tag="75" Click="Zoom_Click"/><MenuItem Header="Zoom _100%" Tag="100" Click="Zoom_Click"/><MenuItem Header="Zoom _125%" Tag="125" Click="Zoom_Click"/><MenuItem Header="Zoom _150%" Tag="150" Click="Zoom_Click"/></MenuItem>
<MenuItem Header="_Keyboard"><MenuItem x:Name="WordProfile" Header="Microsoft _Word" IsCheckable="True" IsChecked="True" Click="Keyboard_Click"/><MenuItem x:Name="WPProfile" Header="Word_Perfect 5.1" IsCheckable="True" Click="Keyboard_Click"/><MenuItem x:Name="WSProfile" Header="Word_Star 4.0" IsCheckable="True" Click="Keyboard_Click"/></MenuItem>
<MenuItem Header="_Tools"><MenuItem Header="_Fields…" Click="Fields_Click"/><Separator/><MenuItem Header="_Macro Library…" Click="MacroLibrary_Click"/><MenuItem Header="_AI Manager…" Click="AiManager_Click"/></MenuItem>
<MenuItem Header="_Help"><MenuItem Header="CtrlZed on _GitHub…" Click="OpenGitHub_Click"/><Separator/><MenuItem Header="_About CtrlZed" Click="About_Click"/></MenuItem>
</Menu>
<ToolBarTray DockPanel.Dock="Top"><ToolBar>
<Button Content="B" FontWeight="Bold" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}"/>
<Button Content="I" FontStyle="Italic" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}"/>
<Button Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}"><TextBlock Text="U" TextDecorations="Underline"/></Button>
<Separator/><Button Content="L" ToolTip="Align left" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}"/><Button Content="C" ToolTip="Centre" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}"/><Button Content="R" ToolTip="Align right" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}"/><Button Content="J" ToolTip="Justify" Command="EditingCommands.AlignJustify" CommandTarget="{Binding ElementName=Editor}"/><Button Content="•" ToolTip="Bullets" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}"/><Button Content="1." ToolTip="Numbering" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}"/>
<Separator/><ComboBox x:Name="StyleBox" Width="125" SelectionChanged="StyleBox_SelectionChanged"><ComboBoxItem IsSelected="True">Normal</ComboBoxItem><ComboBoxItem>Heading 1</ComboBoxItem><ComboBoxItem>Heading 2</ComboBoxItem><ComboBoxItem>Heading 3</ComboBoxItem><ComboBoxItem>Quote</ComboBoxItem><ComboBoxItem>Caption</ComboBoxItem></ComboBox>
<ComboBox x:Name="FontBox" Width="190" SelectionChanged="FontBox_SelectionChanged"/><ComboBox x:Name="SizeBox" Width="70" IsEditable="True" SelectionChanged="SizeBox_SelectionChanged"><ComboBoxItem>9</ComboBoxItem><ComboBoxItem>10</ComboBoxItem><ComboBoxItem>11</ComboBoxItem><ComboBoxItem IsSelected="True">12</ComboBoxItem><ComboBoxItem>14</ComboBoxItem><ComboBoxItem>18</ComboBoxItem><ComboBoxItem>24</ComboBoxItem></ComboBox>
</ToolBar></ToolBarTray>
<StatusBar DockPanel.Dock="Bottom"><StatusBarItem><TextBlock x:Name="Status" Text="Ready — CtrlZed beta 17"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="DocumentStats" Text="0 words · 0 characters · 1 page"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="ZoomStatus" Text="100%"/></StatusBarItem></StatusBar>
<Grid Background="#D7D7D7">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="NavigationPane" Grid.Column="0" Width="240" Background="WhiteSmoke" BorderBrush="#BBB" BorderThickness="0,0,1,0" Visibility="Collapsed">
<DockPanel Margin="8">
<TextBlock DockPanel.Dock="Top" Text="Headings" FontWeight="Bold" Margin="4,4,4,8"/>
<Button DockPanel.Dock="Bottom" Content="Refresh" Margin="4,8,4,4" Click="RefreshNavigation_Click"/>
<ListBox x:Name="NavigationList" SelectionChanged="NavigationList_SelectionChanged"/>
</DockPanel>
</Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#D7D7D7">
<Border x:Name="PageBorder" Width="794" MinHeight="1123" Margin="30" Padding="72" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top">
<Grid>
<RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0" AcceptsTab="True" SpellCheck.IsEnabled="True" FontFamily="Calibri" FontSize="16" VerticalScrollBarVisibility="Disabled" TextChanged="Editor_TextChanged"/>
<local:PageGuideLayer x:Name="PageGuides" IsHitTestVisible="False" Panel.ZIndex="10"/>
</Grid>
</Border>
</ScrollViewer>
</Grid>
</DockPanel></Window>